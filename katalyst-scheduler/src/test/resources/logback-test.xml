<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%-5level %logger{0} - %msg%n</pattern>
        </encoder>
    </appender>

    <!--
        Quiet by default: the scheduler suite exercises job execution heavily and the framework
        logs every registration. Tests that assert on log output raise the level of the one
        logger they inspect themselves.
    -->
    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
